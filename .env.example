# Copy this file to .env and fill in real values. Never commit .env — it's in .gitignore.

# Supabase project settings — find these in the Supabase dashboard under Settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sentry error tracking — find this in Sentry under Settings > Projects > <project> > Client Keys (DSN).
VITE_SENTRY_DSN=

# "development", "staging" or "production" — used to label errors sent to Sentry and to show
# the PRODUCTION/STAGING indicator in the dev console layout.
VITE_APP_ENV=development
